# Copiá este archivo a `.env.local` y completá con tu proyecto Supabase.

# URL de tu proyecto (ej: https://abcdefghijklm.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# (Opcional) Si corrés las Edge Functions en local con `supabase functions serve`
# NEXT_PUBLIC_FUNCTIONS_URL=http://localhost:54321/functions/v1

# SOLO SERVIDOR — clave de rol de servicio (Project Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=

# SOLO SERVIDOR — clave para entrar al panel /admin
ADMIN_SECRET=
